{
  "name": "@nexa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --watch -r @swc-node/register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:deploy": "node dist/db/migrate.js",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nexa/shared": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.64.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/testing": "^11.1.6",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ]
}
