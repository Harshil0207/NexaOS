# ─────────────────────────────────────────────────────────────────────────────
# NexaOS environment. Copy to apps/api/.env (local dev) or the repo root .env
# (docker compose). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime -----------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=4000                            # API port
LOG_LEVEL=info                       # silent|fatal|error|warn|info|debug|trace
TRUST_PROXY_HOPS=0                   # reverse proxies in front of the API (web proxy = 1, + load balancer)

# Data --------------------------------------------------------------------------
DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexa
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Web / sessions ------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000      # comma-separated browser origins (CORS + CSRF). REQUIRED in production.
APP_URL=http://localhost:3000         # public web URL used in emails
SESSION_SECRET=replace-with-64-random-characters-generated-by-openssl-rand-hex-32  # REQUIRED, >= 32 chars
SESSION_TTL_HOURS=168                # absolute session lifetime
SESSION_IDLE_HOURS=24                # idle timeout
# COOKIE_SECURE=true                 # defaults to true in production

# AI providers ----------------------------------------------------------------------
ANTHROPIC_API_KEY=                   # required for agents to run; never exposed to the browser
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-haiku-4-5
LLM_ALLOWED_MODELS=claude-haiku-4-5,claude-sonnet-4-5   # models agents may select
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# LLM_PRICING_JSON={"my-model":{"inputPerMTok":1,"outputPerMTok":5}}   # USD per million tokens

# Runtime & tools -------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=4001
TOOL_TIMEOUT_MS=10000
HTTP_TOOL_ALLOWED_HOSTS=             # e.g. api.example.com,*.partner.io — empty disables httpRequest

# Email (password reset, sendCustomerEmail) --------------------------------------------
SMTP_URL=                            # e.g. smtps://user:pass@smtp.example.com:465 — empty = email unavailable
MAIL_FROM=NexaOS <no-reply@example.com>

# Observability -----------------------------------------------------------------------
METRICS_TOKEN=                       # >= 16 chars enables /metrics (Bearer auth); empty = disabled
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://otel-collector:4318 — empty = tracing off

# Web app (apps/web) ----------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000   # where the web server reaches the API (server-side only)
